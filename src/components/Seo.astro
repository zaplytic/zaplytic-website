---
import { SITE_NAME, SITE_URL, TWITTER_HANDLE } from "@/lib/site";
import { DEFAULT_OG_IMAGE, OG_HEIGHT, OG_WIDTH, type OgImage } from "@/lib/og";
import { GITHUB_ORG_URL } from "@/loaders/product";
import { CONTACT_EMAIL } from "@/loaders/team";

export interface Article {
  publishedTime: string;
  author: string;
  tags: string[];
}

interface Props {
  title?: string;
  description: string;
  /** Canonical path, e.g. "/blog/foo". Defaults to the current URL path. */
  path?: string;
  type?: "website" | "article";
  article?: Article;
  noindex?: boolean;
  /** Link preview image (WhatsApp, Facebook, LinkedIn, X, Slack). Defaults to the site card. */
  image?: OgImage;
  /** Extra JSON-LD nodes for this page (merged into one @graph with the site-wide ones). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  type = "website",
  article,
  noindex = false,
  image = DEFAULT_OG_IMAGE,
  jsonLd = []
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — Software studio in Bangladesh`;
// At build time (build.format "file") the URL ends in ".html"; canonical URLs never do
const pathname =
  (path ?? Astro.url.pathname).replace(/(\/index)?\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(pathname, Astro.site ?? SITE_URL).href;
// Link preview crawlers need an absolute URL
const imageUrl = new URL(image.path, Astro.site ?? SITE_URL).href;

const organization = {
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: SITE_URL,
  logo: {
    "@type": "ImageObject",
    url: `${SITE_URL}/logo.png`,
    width: 512,
    height: 512
  },
  email: CONTACT_EMAIL,
  sameAs: [GITHUB_ORG_URL]
};

const website = {
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE_NAME,
  publisher: { "@id": `${SITE_URL}/#organization` }
};

const graph = { "@context": "https://schema.org", "@graph": [organization, website, ...jsonLd] };
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <link rel="canonical" href={canonical} />
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title ?? SITE_NAME} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={image.alt} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime} />
      <meta property="article:author" content={article.author} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
      <meta name="author" content={article.author} />
      <meta name="keywords" content={article.tags.join(", ")} />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:title" content={title ?? SITE_NAME} />
<meta name="twitter:description" content={description} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={image.alt} />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
