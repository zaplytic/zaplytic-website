<canvas
  data-animated-background
  class="fixed inset-0 -z-10 pointer-events-none h-full w-full"
  aria-hidden="true"></canvas>

<script>
  import { initAnimatedBackground } from "@/scripts/background";

  // Decorative, so it waits until the page has painted: sizing the canvas reads layout, which
  // would otherwise force a synchronous reflow during the initial render.
  const start = () =>
    document.querySelectorAll<HTMLCanvasElement>("[data-animated-background]").forEach((canvas) => {
      initAnimatedBackground(canvas);
    });
  if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 1000 });
  else setTimeout(start, 200);
</script>
